{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=FinancialStatementAI;Trusted_Connection=True;TrustServerCertificate=True;Connect Timeout=5;"
  },
  "Ocr": {
    "Provider": "PaddleOcr",
    "PaddleOcr": {
      "BaseUrl": "http://localhost:8000",
      "TimeoutSeconds": 180
    }
  },
  "DocumentIntelligence": {
    "Provider": "Mock"
  },
  "BackgroundJobs": {
    "Provider": "Immediate"
  },
  "Hangfire": {
    "Storage": "SqlServer"
  },
  "Caching": {
    "Provider": "InMemory",
    "Redis": {
      "ConnectionString": ""
    }
  }
}
