{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=FinancialStatementAI;Trusted_Connection=True;TrustServerCertificate=True;Connect Timeout=5;"
  },
  "Jwt": {
    "Issuer": "FinancialStatementAI",
    "Audience": "FinancialStatementAI.Web",
    "ExpiryMinutes": 60
  },
  "FileStorage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "App_Data/uploads"
    },
    "Azure": {
      "ContainerName": "statements"
    }
  },
  "Ocr": {
    "Provider": "Mock"
  },
  "DocumentIntelligence": {
    "Provider": "Mock"
  },
  "Classification": {
    "Provider": "Mock"
  },
  "BackgroundJobs": {
    "Provider": "Immediate"
  },
  "Hangfire": {
    "Storage": "SqlServer"
  },
  "Azure": {
    "Vision": {},
    "DocumentIntelligence": {},
    "OpenAI": {}
  },
  "OpenAI": {}
}
