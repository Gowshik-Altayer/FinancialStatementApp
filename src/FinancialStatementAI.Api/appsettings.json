{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=FinancialStatementAI;Trusted_Connection=True;TrustServerCertificate=True;Connect Timeout=5;"
  },
  "Jwt": {
    "Issuer": "FinancialStatementAI",
    "Audience": "FinancialStatementAI.Web",
    "ExpiryMinutes": 60
  },
  "FileStorage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "App_Data/uploads"
    },
    "Azure": {
      "ContainerName": "statements"
    }
  },
  "Ocr": {
    "Provider": "PaddleOcr",
    "PaddleOcr": {
      "BaseUrl": "http://localhost:8000",
      "TimeoutSeconds": 180
    }
  },
  // "Mock" disables PP-StructureV3 table reconstruction. It is documented as memory-hungry and was
  // observed here segfaulting the whole OCR service (exit 139) on every scanned-statement run,
  // which took OCR text extraction down with it — see ocr-service/README.md, which recommends
  // exactly this setting when it proves unreliable on a given machine.
  // Turning it off no longer costs transaction extraction: TransactionExtractionService's
  // cell-per-line fallback reconstructs rows directly from OCR text, which is the job the table
  // pipeline previously had to do. Switch back to "PaddleOcr" on a machine with enough free RAM
  // (or a GPU build) if you want the richer table/layout metadata it also captures.
  "DocumentIntelligence": {
    "Provider": "Mock"
  },
  "Classification": {
    "Provider": "Embeddings"
  },
  "BackgroundJobs": {
    "Provider": "Immediate"
  },
  "Hangfire": {
    "Storage": "SqlServer"
  },
  "Caching": {
    "Provider": "InMemory",
    "Redis": {
      "ConnectionString": ""
    }
  },
  "Azure": {
    "Vision": {},
    "DocumentIntelligence": {},
    "OpenAI": {}
  },
  "OpenAI": {},
  "Embeddings": {}
}
