# Copy this file to .env before running `docker compose up --build` — .env is gitignored.

# SQL Server "sa" password. Must satisfy SQL Server's complexity policy: 8+ characters including
# uppercase, lowercase, digits, and a symbol.
MSSQL_SA_PASSWORD=Ch4ngeMe!2026

# JWT signing key for the Api container — 32+ characters. Never reuse the placeholder committed
# in appsettings.Development.json for anything beyond local Docker experimentation.
JWT_SIGNING_KEY=a-long-random-string-at-least-32-characters-replace-me
